# ─────────────────────────────────────────────────────────────────────────────
# Strategya · variables de entorno
# Copia este archivo a .env.local para desarrollo. En producción se cargan en
# Vercel (app) y en Supabase → Edge Functions → Secrets (ingesta).
# La app no usa NEXT_PUBLIC_*. Solo la URL y la clave publicable llegan al navegador (para Realtime).
# ─────────────────────────────────────────────────────────────────────────────

# ── Vercel (app Next.js) ─────────────────────────────────────────────────────
# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Supabase → Project Settings → API Keys → «Publishable key» (sb_publishable_…)
# o, en proyectos con claves antiguas, la «anon key». Es pública por diseño: RLS protege los datos.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# El único correo que puede entrar. Cualquier otro se rechaza aunque tenga cuenta.
STRATEGYA_EMAIL_DUENO=tu-correo@ejemplo.com

# ── Supabase → Edge Functions → Secrets (ingesta) ────────────────────────────
# Secreto que pg_cron manda en cada llamada. Mínimo 32 caracteres; genera uno con:
#   openssl rand -hex 32
# Debe ser EXACTAMENTE el mismo que se guarda en Vault con mercado.configurar_tareas(...).
STRATEGYA_SECRETO_TAREAS=
# Correo de contacto que va en el User-Agent (la SEC lo exige; solo se manda a sec.gov).
STRATEGYA_CONTACTO=
# SUPABASE_URL y la clave de servidor las inyecta Supabase solo: no se configuran.

# ── Pruebas locales ──────────────────────────────────────────────────────────
# Postgres 15+ con un usuario que pueda crear bases (las pruebas crean y borran la suya).
DATABASE_URL_PRUEBAS=postgres://postgres:postgres@localhost:5432/postgres

# ── Supabase → Edge Functions → Secrets (fuentes con clave; las carga el despliegue) ──
# Sin su clave, cada tarea termina «parcial» con el motivo y no llama a nada.
# FMP_API_KEY=
# FMP_LLAMADAS_DIA=240
# FINNHUB_API_KEY=
# Alertas por correo
# RESEND_API_KEY=
# ALERTAS_EMAIL_DESTINO=
# Boletín por correo (docs/boletin.md). Sin BOLETIN_PARA va al correo del usuario dueño en la base.
# BOLETIN_PARA=
# STRATEGYA_URL_APP=https://tu-app.vercel.app
# IA (porqués y resúmenes; tope mensual en US$)
# ANTHROPIC_API_KEY=
# IA_TOPE_MENSUAL_USD=10
# Buques en pasos marítimos (opcional; solo corre con ambas)
# AISSTREAM_API_KEY=
# GLOBO_AIS_ACTIVO=1
